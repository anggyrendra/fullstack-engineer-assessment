{
    "name": "fomotoko/online-store",
    "description": "Task 1 - Online Store flash-sale API with race-condition handling (Fullstack Engineer Assessment Test).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Fomotoko\\OnlineStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fomotoko\\OnlineStore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public public/index.php",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "race-test": "php tests/RaceConditionTest.php"
    }
}
