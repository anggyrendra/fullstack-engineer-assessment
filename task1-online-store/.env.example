# Copy this file to ".env" and adjust the values for your environment.
# The application reads these through the Fomotoko\OnlineStore\Support\Config class.

DB_DRIVER=mysql          ; mysql or sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_store
DB_USER=root
DB_PASS=

; When DB_DRIVER=sqlite this file is used instead of the MySQL settings above.
DB_SQLITE_PATH=database/online_store.sqlite

; Port used by the built-in PHP development server (composer serve).
APP_PORT=8000
APP_ENV=development
